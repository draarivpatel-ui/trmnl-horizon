<div class="view view--half_vertical">
  <div class="layout layout--col gap--space-between">
    <div class="grid grid--cols-2">
      <div class="item">
        <div class="meta"><span class="index">BYOS</span></div>
        <div class="content">
          <span class="title title--small">{{ cluster_name | default: "TRMNL-BYOS // RACK-03 TELEMETRY" }}</span>
          <span class="description">HOST {{ host_ip | default: "10.24.0.18:8080" }} // {{ firmware_target | default: "ESP32-C3 FW 1.6.8" }}</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"><span class="index">POWER</span></div>
        <div class="content">
          <span class="value value--medium value--tnums">{{ trmnl.battery_voltage | default: "4.04" }}V</span>
          <span class="label label--small label--inverted">RSSI {{ trmnl.rssi | default: "-58" }} dBm</span>
        </div>
      </div>
    </div>
    <div class="divider"></div>
    <div class="grid grid--cols-2">
      {% for node in nodes %}
      <div class="item bg--gray-5">
        <div class="meta"><span class="index">{{ forloop.index }}</span></div>
        <div class="content">
          <span class="label">{{ node.name }}</span>
          <span class="description">CPU {{ node.cpu_pct }}% // TEMP {{ node.tempC }}°C // {{ node.status }}</span>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  <div class="title_bar">
    <span class="title">TRMNL Horizon // Lab Bench Telemetry</span>
    <span class="instance">{{ trmnl.plugin_settings.instance_name | default: "Rack-03" }}</span>
  </div>
</div>
